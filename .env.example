# ─────────────────────────────────────────────────────────────────────────────
# Retail Solutions — environment template
# Copy to .env.local and fill in. Nothing here is required for the site to run
# in demo mode: leads fall back to local file storage and analytics is a no-op
# until a provider is configured.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph, hreflang)
NEXT_PUBLIC_SITE_URL=https://retailsolutions.ir

# ── Official contact details ─────────────────────────────────────────────────
# LAUNCH GATE: the production phone number MUST be set here (or the phone
# component disabled via NEXT_PUBLIC_PHONE_ENABLED=false) before go-live.
# The temporary profile number (+98 21 0000 0000) must never be published.
NEXT_PUBLIC_OFFICIAL_PHONE=
NEXT_PUBLIC_PHONE_ENABLED=false
NEXT_PUBLIC_CONTACT_EMAIL=info@retailsolutions.ir
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/retailsolutions
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOW_POWERED_BY_NOVARK=true

# ── Analytics abstraction (choose one or leave blank for no-op) ───────────────
# provider: plausible | matomo | ga | local | (empty = disabled)
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# ── Lead integration abstraction ─────────────────────────────────────────────
# Server-side only. The integration layer degrades gracefully: any unset
# channel is skipped, and a local JSON fallback (./.data/leads.json) always
# records the lead so nothing is lost if a foreign SaaS is unreachable in Iran.
LEAD_DATABASE_URL=
LEAD_NOTIFY_EMAIL_TO=
LEAD_NOTIFY_EMAIL_FROM=
SMTP_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_WEBHOOK_URL=
CRM_WEBHOOK_URL=
